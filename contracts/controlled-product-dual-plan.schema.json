{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amazon-crawler-v2.local/contracts/controlled-product-dual-plan.schema.json",
  "title": "Amazon Crawler V2 current-legacy-source product dual plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "run_id",
    "authorization_reference",
    "environment",
    "check_receipts",
    "scenarios"
  ],
  "properties": {
    "schema_version": {"const": "controlled-product-dual-plan.v1"},
    "batch_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 500},
    "environment": {"const": "isolated"},
    "check_receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_recovery",
        "cookie_proxy_redaction",
        "legacy_bridge_roundtrip"
      ],
      "properties": {
        "checkpoint_recovery": {
          "$ref": "controlled-shadow-plan.schema.json#/$defs/checkpointRecoveryReceipt"
        },
        "cookie_proxy_redaction": {
          "$ref": "controlled-shadow-plan.schema.json#/$defs/cookieProxyRedactionReceipt"
        },
        "legacy_bridge_roundtrip": {
          "$ref": "controlled-shadow-plan.schema.json#/$defs/legacyBridgeRoundtripReceipt"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "case",
          "authorized",
          "marketplace_id",
          "postal_code",
          "input"
        ],
        "properties": {
          "kind": {"enum": ["product", "product_hw", "product_time"]},
          "case": {"const": "success"},
          "authorized": {"const": true},
          "marketplace_id": {"type": "string", "minLength": 1},
          "postal_code": {"type": "string", "minLength": 1},
          "input": {"type": "object", "minProperties": 1}
        }
      }
    }
  }
}
