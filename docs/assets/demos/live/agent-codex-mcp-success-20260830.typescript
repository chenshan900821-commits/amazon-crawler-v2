":true,"static_cookie_configured":false,"overseas_pool_configured":true,"values_disclosed":false},"proxy":{"required_for_ordinary_crawl":false,"required_for_cookie_harvest":true,"configured":true,"selected_mode":"dynamic_extraction_api","dynamic_extract_url_configured":true,"fixed_connection_url_configured":false,"dynamic_tunnel_credentials":"configured","precedence":"dynamic_extraction_api_over_fixed_connection_url","values_disclosed":false},"worker":{"runtime_status":"not_verified","serve_will_start_embedded_worker":true,"message":"配置检查无法证明 Worker 进程正在运行；创建任务后必须用 show 确认状态离开 pending。"},"storage":{"state_database_configured":true,"canonical_sink":"sqlite","values_disclosed":false}},"blocking_issues":[],"warnings":[],"next_steps":["配置项检查已通过；这不代表 Redis、代理或 Amazon 已完成真实连通性验证。","确认另一个进程正在运行 amazon-crawler serve 或 amazon-crawler worker。"],"mcp_runtime":{"production":false,"authentication":"disabled","oauth_provider":"generic","tenant_mode":"claim","tenant_scoped":true,"synchronous_run_enabled":true,"single_instance_storage":true}}},"error":null,"status":"completed"}}
