# Persistence
CRAWLER_DB_PATH=.data/crawler.db
CRAWLER_EVIDENCE_DIR=.data/evidence
CRAWLER_CAPTURE_EVIDENCE=false

# Worker and network policy
CRAWLER_WORKER_ENABLED=true
CRAWLER_WORKER_CONCURRENCY=2
CRAWLER_POLL_SECONDS=1.0
CRAWLER_LEASE_SECONDS=90
CRAWLER_REQUEST_TIMEOUT_SECONDS=25
CRAWLER_MIN_HOST_INTERVAL_SECONDS=1.5
CRAWLER_MAX_RESPONSE_BYTES=5000000
CRAWLER_USER_AGENT=AmazonCrawlerV2/0.1 (+contact@example.com)
# auto uses curl_cffi TLS/browser impersonation when installed; httpx is an
# explicit diagnostics fallback and does not provide browser TLS impersonation.
CRAWLER_HTTP_TRANSPORT=auto

# Optional runtime secrets. Never submit these through the API or commit them.
CRAWLER_HTTP_PROXY=
CRAWLER_AMAZON_COOKIE=
# Old merchant and rank spiders use a dedicated static Cookie.
CRAWLER_MERCHANT_COOKIE=
CRAWLER_REQUIRE_COOKIE=true

# Legacy-compatible Cookie pools. The overseas pool corresponds to old Redis DB
# 4: product_hw always uses it, while all other pool-backed tasks use it for JP.
# CRAWLER_COOKIE_REDIS_JP_URL remains a deprecated alias for OVERSEAS_URL.
CRAWLER_COOKIE_REDIS_URL=
CRAWLER_COOKIE_REDIS_OVERSEAS_URL=
CRAWLER_COOKIE_REDIS_JP_URL=
CRAWLER_COOKIE_REFRESH_SECONDS=1800
CRAWLER_COOKIE_QUARANTINE_SECONDS=900
CRAWLER_COOKIE_HARVEST_CONCURRENCY=2
CRAWLER_COOKIE_HARVEST_MAX_ATTEMPTS=4
CRAWLER_COOKIE_TTL_SECONDS=172800
CRAWLER_COOKIE_HARVEST_REQUIRE_PROXY=true
CRAWLER_COOKIE_MAINTENANCE_ENABLED=false
CRAWLER_COOKIE_TARGETS_PATH=.data/cookie_targets.json
CRAWLER_COOKIE_MAINTENANCE_INTERVAL_SECONDS=1800

# Dynamic proxy extraction. Endpoint and credentials are runtime secrets.
CRAWLER_PROXY_EXTRACT_URL=
CRAWLER_PROXY_USERNAME=
CRAWLER_PROXY_PASSWORD=
CRAWLER_PROXY_QUARANTINE_SECONDS=300
# Only when loading the old config: choose one allowlisted old proxy route.
# Supported values: qg, qghw, qgal, jlal. Values and credentials stay secret.
CRAWLER_LEGACY_PROXY_ROUTE=qg

# Optional legacy bridge. Both URLs are runtime secrets; leave empty unless
# running an explicit legacy-import/export/sync command.
CRAWLER_LEGACY_MYSQL_URL=
CRAWLER_LEGACY_RESULT_REDIS_URL=

# Required only for an explicitly authorized isolated shadow collection. This
# is a change/ticket reference, not a credential, and must match the plan.
CONTROLLED_ACCEPTANCE_AUTHORIZATION=
